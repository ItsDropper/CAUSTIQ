{
  "schemaVersion": 1,
  "id": "caustiq",
  "version": "${version}",
  "name": "Caustiq",
  "description": "Shader-pack engine with an optional Sodium + Nvidium accelerated terrain backend.",
  "authors": ["ItsDropper"],
  "contact": {
    "homepage": "https://github.com/ItsDropper/CAUSTIQ/tree/nvidium",
    "sources": "https://github.com/ItsDropper/CAUSTIQ/tree/nvidium"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["dev.itsdropper.caustiq.CaustiqClient"],
    "sodium:config_api_user": ["dev.itsdropper.caustiq.integration.sodium.CaustiqSodiumConfig"]
  },
  "mixins": ["caustiq.mixins.json"],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "sodium": "*",
    "nvidium": "*"
  }
}
